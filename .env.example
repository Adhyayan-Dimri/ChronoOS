# ChronoOS Environment Configuration
# Optional: Provide AWS credentials to connect live to Amazon Bedrock models.
# If omitted, ChronoOS runs in Autonomous High-Fidelity Simulation Mode.

# AWS Credentials for Amazon Bedrock
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Amazon Bedrock Model Configuration
# Supported options:
# - anthropic.claude-3-5-sonnet-20241022-v2:0 (Claude 3.5 Sonnet v2)
# - amazon.nova-pro-v1:0 (Amazon Nova Pro)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Server Gateway Configuration
HOST=127.0.0.1
PORT=8000
