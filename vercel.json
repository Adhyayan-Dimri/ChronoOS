{
  "version": 2,
  "name": "chronoos",
  "public": true,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://chronoos-api.onrender.com/api/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://chronoos-api.onrender.com/mcp"
    },
    {
      "source": "/sse",
      "destination": "https://chronoos-api.onrender.com/sse"
    },
    {
      "source": "/message",
      "destination": "https://chronoos-api.onrender.com/message"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
